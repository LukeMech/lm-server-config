# ghcr.io/lukemech/lm-server-webapp -- generic runner for the Flask sites
# (toolbox, website, exp). No site code in the image: the entrypoint clones
# APP_REPO at start (private repos with APP_GITHUB_TOKEN), keeps it pulled,
# and restarts when a new commit lands.
FROM quay.io/almalinuxorg/10-minimal:10

# From the system only the interpreter and non-Python tools: python3 (+ the
# pip wheel `python3 -m venv` bootstraps from), git (the site repo),
# findutils (entrypoint). Every Python package comes from pip (below).
RUN microdnf -y install --setopt=install_weak_deps=0 --nodocs \
        curl \
        findutils \
        git-core \
        python3 \
        python3-pip-wheel \
    && microdnf -y clean all

# Emoji (flags too) in the rendercv CV: Typst picks up system fonts and
# renders the COLRv1 glyphs in color. EL's google-noto-color-emoji-fonts is
# older and has only the bitmap (CBDT) font, so the COLRv1 one comes from
# the upstream release, checksum-pinned.
ARG NOTO_EMOJI_VERSION=v2.051
ARG NOTO_EMOJI_SHA256=0ae57fe58645638523ba35f388d93739d292539a9acb84df5700c81b1e1a28d2
RUN mkdir -p /usr/share/fonts/noto-emoji \
    && curl -fsSL -o /usr/share/fonts/noto-emoji/Noto-COLRv1.ttf \
        "https://github.com/googlefonts/noto-emoji/raw/${NOTO_EMOJI_VERSION}/fonts/Noto-COLRv1.ttf" \
    && echo "${NOTO_EMOJI_SHA256}  /usr/share/fonts/noto-emoji/Noto-COLRv1.ttf" | sha256sum -c -

# Everything the sites need, in one venv -- one image for all of them,
# nothing is installed per site at start (requirements.txt says what each
# package is for).
ENV VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
COPY requirements.txt /opt/lm-server-webapp/requirements.txt
RUN python3 -m venv /opt/venv \
    && pip install --no-cache-dir --disable-pip-version-check -r /opt/lm-server-webapp/requirements.txt \
    && python3 -c 'import flask, flask_babel, babel, gunicorn' \
    && pybabel --version \
    && rendercv --version \
    && pdf-compressor --help >/dev/null

COPY entrypoint.sh /usr/local/bin/lm-server-webapp
RUN chmod 0755 /usr/local/bin/lm-server-webapp

ENV HOME=/data \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1
VOLUME ["/data"]
ENTRYPOINT ["/usr/local/bin/lm-server-webapp"]
