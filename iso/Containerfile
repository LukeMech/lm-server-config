# The installer ISO's environment: Anaconda as a bootable container.
# image-builder (bootc-generic-iso, build-iso.yml / `just build-iso`) turns
# it into the ISO and embeds ghcr.io/lukemech/lm-server:latest as the
# payload that Anaconda installs (kickstart: interactive-defaults.ks).
#
# Follows osbuild's own EL10 installer, stream10-installer in
# https://github.com/osbuild/bootc-foundry, on AlmaLinux instead of CentOS
# Stream. No heredocs (the CI's podman is too old for COPY <<EOT).
#
# Built from the repo root (podman build -f iso/Containerfile .), for the
# shared build_files/remove-packages.sh.
FROM quay.io/almalinuxorg/almalinux-bootc:10

# Before anything is installed: drop what the installed system drops too
# (build_files/remove-packages.sh -- firmware for anything but lm-server's
# Intel hardware, kdump, NFS, Bluetooth, domain join, cloud agents). Whatever
# Anaconda really needs, its install below brings back.
RUN --mount=type=bind,source=build_files/remove-packages.sh,target=/tmp/remove-packages.sh \
    bash /tmp/remove-packages.sh \
    && dnf clean all

# bootc images ship an empty /boot (bootupd keeps it in
# /usr/lib/bootupd/updates); the ISO needs /boot/efi/EFI populated, which
# reinstalling shim does.
RUN dnf -y reinstall shim-x64 \
    && dnf clean all

# Anaconda, and what image-builder needs to build the ISO out of this. No
# google-noto-sans-cjk-fonts (osbuild's installer has them): it runs in
# English/Polish here; Chinese/Japanese/Korean would show as boxes.
RUN dnf -y install \
        anaconda \
        anaconda-install-img-deps \
        anaconda-dracut \
        dracut-config-generic \
        dracut-network \
        net-tools \
        grub2-efi-x64-cdboot \
        plymouth \
        default-fonts-core-sans \
        default-fonts-other-sans \
        xorriso \
        squashfs-tools \
        fuse-overlayfs \
    && dnf clean all
# The installer is all there (and which removed packages Anaconda brought
# back: a warning only).
RUN --mount=type=bind,source=build_files/remove-packages.sh,target=/tmp/remove-packages.sh \
    bash /tmp/remove-packages.sh --check \
        anaconda anaconda-install-img-deps anaconda-dracut grub2-efi-x64-cdboot

# ISO label and boot menu (read by image-builder).
COPY iso/iso.yaml /usr/lib/image-builder/bootc/iso.yaml

# What Anaconda installs and how; the installer only asks for the disk and
# the network.
COPY iso/interactive-defaults.ks /usr/share/anaconda/interactive-defaults.ks
COPY iso/anaconda.conf /etc/anaconda/conf.d/90-lm-server.conf

# What lorax normally does to make Anaconda run, the bare minimum: the
# "install" user runs Anaconda, boot into anaconda.target, a shell on VT2.
RUN echo "install:x:0:0:root:/root:/usr/libexec/anaconda/run-anaconda" >> /etc/passwd \
    && echo "install::14438:0:99999:7:::" >> /etc/shadow \
    && passwd -d root
RUN mv /usr/share/anaconda/list-harddrives-stub /usr/bin/list-harddrives \
    && mv /etc/yum.repos.d /etc/anaconda.repos.d \
    && ln -s /lib/systemd/system/anaconda.target /etc/systemd/system/default.target \
    && rm -v /usr/lib/systemd/system-generators/systemd-gpt-auto-generator
RUN rm /usr/lib/systemd/system/autovt@.service \
    && ln -s /usr/lib/systemd/system/anaconda-shell@.service /usr/lib/systemd/system/autovt@.service
COPY iso/anaconda-shell.conf /usr/lib/systemd/logind.conf.d/anaconda-shell.conf
# The graphical installer runs as root; PipeWire refuses to otherwise.
COPY iso/pipewire-allowroot.conf /etc/systemd/user/pipewire.service.d/allowroot.conf
COPY iso/pipewire-allowroot.conf /etc/systemd/user/pipewire.socket.d/allowroot.conf

# Initramfs that boots into the installer.
RUN kernel=$(kernel-install list --json pretty | jq -r '.[] | select(.has_kernel == true) | .version') \
    && DRACUT_NO_XATTR=1 dracut --force -v --zstd --reproducible --no-hostonly \
        --add "anaconda" \
        --add "lvm" \
        "/usr/lib/modules/${kernel}/initramfs.img" "${kernel}"
