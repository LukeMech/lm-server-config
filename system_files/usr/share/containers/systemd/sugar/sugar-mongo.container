[Unit]
Description=sugar: sugar-mongo
ConditionPathExists=/var/lib/lm-server/env/sugar/enabled

[Container]
ContainerName=sugar-mongo
Pod=sugar.pod
# MongoDB 9.0, the major release (patched until October 2031): auto-updated
# within 9.0.x, without the minor releases (9.1, 9.2, ...) that "9" would
# follow. Never latest: the next major (10.0) needs the data's
# featureCompatibilityVersion raised to 9.0 first, by hand.
Image=docker.io/library/mongo:9.0
AutoUpdate=registry
Volume=/var/lib/lm-server/volumes/sugar/mongo:/data/db:Z
NoNewPrivileges=true

[Service]
Slice=lm-server-sugar.slice
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=sugar-pod.service
