[Unit]
Description=sugar: sugar-mongo
ConditionPathExists=/var/lib/lm-server/env/sugar/enabled

[Container]
ContainerName=sugar-mongo
Pod=sugar.pod
# The major MongoDB Atlas runs (what most Nightscouts use); within it
# auto-updated. Another major needs its data upgraded by hand.
Image=docker.io/library/mongo:8.0
AutoUpdate=registry
Volume=/var/lib/lm-server/volumes/sugar/mongo:/data/db:Z
NoNewPrivileges=true

[Service]
Slice=lm-server-sugar.slice
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=sugar-pod.service
