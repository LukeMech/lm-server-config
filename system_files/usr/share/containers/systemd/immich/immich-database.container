[Unit]
Description=immich: immich-database
ConditionPathExists=/var/lib/lm-server/env/immich/enabled

[Container]
ContainerName=immich-database
Pod=immich.pod
# Pinned: database/extension upgrades are a manual step (Immich release notes).
Image=ghcr.io/immich-app/postgres:14-vectorchord0.4.3-pgvectors0.2.0
EnvironmentFile=/var/lib/lm-server/env/immich/database.env
Environment=POSTGRES_INITDB_ARGS=--data-checksums
ShmSize=128m
Volume=/var/lib/lm-server/volumes/immich/postgres:/var/lib/postgresql/data:Z
NoNewPrivileges=true

[Service]
Slice=lm-server-immich.slice
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=immich-pod.service
