# lm-server: description ConvertX
# lm-server: route edit.lukemech.org/converter http://localhost:3001
# Served under /converter/ of edit.lukemech.org, listed on its hub (storytold/).
# lm-server: env WEBROOT=/converter
# lm-server: env ACCOUNT_REGISTRATION=false
# lm-server: env HTTP_ALLOWED=false
# lm-server: require JWT_SECRET
[Unit]
Description=convert: convert
ConditionPathExists=/var/lib/lm-server/env/convert/enabled
RequiresMountsFor=/var/lib/lm-server/volumes/convert

[Container]
ContainerName=convert
Image=ghcr.io/c4illin/convertx:latest
AutoUpdate=registry
Network=convert.network
PublishPort=127.0.0.1:3001:3000
EnvironmentFile=/var/lib/lm-server/env/convert/convert.env
Volume=/var/lib/lm-server/volumes/convert:/app/data:Z
NoNewPrivileges=true

[Service]
Slice=lm-server-convert.slice
Restart=always
TimeoutStartSec=900
