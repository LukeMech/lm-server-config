[Unit]
Description=remote: remote-db
ConditionPathExists=/var/lib/lm-server/env/remote/enabled

[Container]
ContainerName=remote-db
Pod=remote.pod
Image=docker.io/library/postgres:16
AutoUpdate=registry
EnvironmentFile=/var/lib/lm-server/env/remote/database.env
Volume=/var/lib/lm-server/volumes/remote/postgres:/var/lib/postgresql/data:Z
# Guacamole schema (rendered by lm-server) -- only read on first init.
Volume=/var/lib/lm-server/env/remote/initdb:/docker-entrypoint-initdb.d:ro,Z
NoNewPrivileges=true

[Service]
Slice=lm-server-remote.slice
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=remote-pod.service
