[Unit]
Description=cloudflared: cloudflared
ConditionPathExists=/var/lib/lm-server/env/cloudflared/enabled
Wants=network-online.target
After=network-online.target

[Container]
ContainerName=cloudflared
# Host network: routes in the Cloudflare dashboard point at http://localhost:<port>.
Image=docker.io/cloudflare/cloudflared:latest
AutoUpdate=registry
Network=host
EnvironmentFile=/var/lib/lm-server/env/cloudflared/cloudflared.env
Exec=tunnel --no-autoupdate run
DropCapability=ALL
ReadOnly=true
NoNewPrivileges=true

[Service]
Restart=always
TimeoutStartSec=900
