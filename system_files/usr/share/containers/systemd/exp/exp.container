# lm-server: description exp.lukemech.org (CV)
# lm-server: route exp.lukemech.org http://localhost:7999
# lm-server: env APP_REPO=LukeMech/CV
# lm-server: env APP_MODULE=server:app
# lm-server: env APP_PORT=7999
# lm-server: env APP_BUILD_CMD=rendercv render Łukasz_Błaszczyk_CV_EN.yaml
# lm-server: env APP_COMPRESS_PDF=en/Łukasz_Błaszczyk_CV.pdf
# lm-server: env APP_GITHUB_TOKEN={{github_token}}
# lm-server: env APP_GITHUB_USER={{github_user}}
[Unit]
Description=exp: exp
ConditionPathExists=/var/lib/lm-server/env/exp/enabled
RequiresMountsFor=/var/lib/lm-server/volumes/exp

[Container]
ContainerName=exp
# Site code is cloned at start from APP_REPO (see images/webapp).
Image=ghcr.io/lukemech/lm-server-webapp:latest
AutoUpdate=registry
Network=exp.network
PublishPort=127.0.0.1:7999:7999
EnvironmentFile=/var/lib/lm-server/env/exp/exp.env
# Own user namespace: root in here is an unprivileged uid on the host.
UserNS=auto
Volume=/var/lib/lm-server/volumes/exp:/data:Z,U
ReadOnly=true
Tmpfs=/tmp
DropCapability=ALL
NoNewPrivileges=true

[Service]
Slice=lm-server-exp.slice
Restart=always
# A failed clone (e.g. no access to APP_REPO) retries slowly, not in a loop.
RestartSec=15
TimeoutStartSec=900
