[Unit]
Description=storytold: storytold-design
ConditionPathExists=/var/lib/lm-server/env/storytold/enabled

[Container]
ContainerName=storytold-design
Pod=storytold.pod
# designcraft's web build, downloaded from its GitHub release (see images/craft).
Image=ghcr.io/lukemech/lm-server-craft:latest
AutoUpdate=registry
Environment=CRAFT_REPO=storytold/designcraft CRAFT_PORT=8087
EnvironmentFile=/var/lib/lm-server/env/storytold/storytold.env
Volume=/var/lib/lm-server/volumes/storytold/design:/data:Z,U
ReadOnly=true
Tmpfs=/tmp
DropCapability=ALL
NoNewPrivileges=true

[Service]
Slice=lm-server-storytold.slice
Restart=always
# No release to serve yet and GitHub unreachable: retry slowly, not in a loop.
RestartSec=60
TimeoutStartSec=900

[Install]
WantedBy=storytold-pod.service
