[Unit]
Description=lm-server: pull configs from the secrets repo and apply them
Wants=network-online.target
After=network-online.target lm-server-services.service
ConditionPathExists=/var/lib/lm-server/secrets.env

[Service]
Type=oneshot
# Already a service: sync runs right here (see run_detached in lm-server).
Environment=LMS_DETACHED=1
ExecStart=/usr/bin/lm-server config pull
