[Unit]
Description=lm-server: pull configs from the secrets repo and apply them

[Timer]
# Always once shortly after boot; then on the [updates] config schedule
# (default hourly, "manual" = boot only -- apply-host.sh writes a drop-in).
OnBootSec=1min
OnCalendar=hourly
RandomizedDelaySec=2min
Persistent=true

[Install]
WantedBy=timers.target
