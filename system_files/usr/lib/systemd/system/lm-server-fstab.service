[Unit]
Description=lm-server: match the system disk lines in /etc/fstab to bootc
Documentation=file:///usr/libexec/lm-server/fstab-drop-root.sh
# Only on bootc's read-only composefs root (where the line is never used).
ConditionPathIsReadWrite=!/
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/libexec/lm-server/fstab-drop-root.sh

[Install]
WantedBy=multi-user.target
