#!/bin/bash
# lm-server -- manage this lm-server host: configs, services, updates.
set -euo pipefail

# shellcheck source=../libexec/lm-server/lib.sh
. /usr/libexec/lm-server/lib.sh

usage() {
    cat <<'EOF'
usage: lm-server <command> [args]

  status                       system image, config, services, schedules
  history [N]                  last N lines of the automatic runs
  update [--config] [-c|--containers] [-s|--system] [--check] [--apply]
                               update the config, the containers and the system
                               image, in this order -- all three, or the ones
                               named (-cs: containers + system). --check: only
                               what's new. --apply: reboot into a new system image

System (bootc image from ghcr.io/lukemech/lm-server)
  system update [--check]      download the next system image (applied on reboot)
  system update --apply        download it and reboot into it now
  system update --progress ... the same, plus progress as JSON lines (Cockpit)
  system rollback              boot the previous system image on next reboot

Containers (updated independently of the system)
  containers [--json]          image + version each container runs, and what's newer
  containers update [--check]  pull newer images, restart what changed, then clean up
  containers cleanup           remove images no container or quadlet uses
  containers remove-adhoc      remove containers not defined by this image

Config (private lm-server-config-secrets repo)
  config setup                 (re)enter the GitHub repo + credentials
  config pull [--force]        fetch changes pushed to GitHub and apply them
  config show|save             print lm-server.toml / save a new one (stdin): commit, push, apply
  config status                applied commit vs. the newest one on GitHub

Services
  services                     list services and their state
  services start|stop|restart <service>
  services logs <service> [-f]
  services resources [--json]  CPU / memory / disk of each service vs. its limits
  services routes              Cloudflare Tunnel routes this host expects
EOF
}

# ------------------------------------------------------------------ setup

cmd_setup() {
    local firstboot=0 repo="" branch="" config="" user="" token="" token_stdin=0
    while (($#)); do
        case $1 in
        --firstboot) firstboot=1 ;;
        --repo) repo=$2 && shift ;;
        --branch) branch=$2 && shift ;;
        --config) config=$2 && shift ;;
        --user) user=$2 && shift ;;
        --token-stdin) token_stdin=1 ;;
        *) lms_die "setup: unknown argument $1" ;;
        esac
        shift
    done

    if ((firstboot)) && [[ -f ${LMS_SECRETS_ENV} ]]; then
        exit 0
    fi

    lms_load_secrets || true
    local def_repo=${LMS_S[REPO]:-${LMS_DEFAULT_REPO}}
    local def_branch=${LMS_S[BRANCH]:-main}
    local def_config
    def_config=$(secrets_config_path)
    local def_user=${LMS_S[GITHUB_USER]:-}

    if ((token_stdin)); then
        # Non-interactive (Cockpit): everything from args, token from stdin.
        IFS= read -r token || true
        repo=${repo:-${def_repo}} branch=${branch:-${def_branch}} config=${config:-${def_config}}
        setup_save "${repo}" "${branch}" "${config}" "${user}" "${token}"
        return
    fi

    # First boot: no one can log in until the admin from lm-server.toml
    # exists, so there is no skip or timeout -- ask until it works.
    ((firstboot)) && quiet_console
    local attempt=0
    while :; do
        attempt=$((attempt + 1))
        if ((!firstboot && attempt > 3)); then
            lms_log "setup failed -- run: sudo lm-server config setup"
            return 1
        fi
        clear 2>/dev/null || true
        cat <<EOF

  ================= lm-server: first configuration =================

  Service configs, logins and passwords are pulled from a private GitHub
  repo (template: lm-server-config-secrets/ in LukeMech/lm-server-config).

  GitHub no longer accepts account passwords for git -- use a token:
  github.com > Settings > Developer settings > Fine-grained tokens,
  repository access: the secrets repo (+ private website repos),
  permission "Contents: Read-only".

  The admin login comes from lm-server.toml, so this has to succeed
  before anyone can sign in.

EOF
        read -r -p "  Secrets repo (owner/name) [${def_repo}]: " repo || {
            # No terminal to ask on (stdin closed).
            echo
            lms_log "no answer -- run: sudo lm-server config setup"
            return 1
        }
        repo=${repo:-${def_repo}}
        read -r -p "  Branch [${def_branch}]: " branch || true
        branch=${branch:-${def_branch}}
        read -r -p "  Config file (.toml) inside the repo [${def_config}]: " config || true
        config=${config:-${def_config}}
        read -r -p "  GitHub username [${def_user}]: " user || true
        user=${user:-${def_user}}
        # Shown while typing: a 90-character token is hard to enter blind.
        read -r -p "  GitHub token (empty for a public repo): " token || true
        ((firstboot)) && clear 2>/dev/null || true # don't leave it on the console
        if setup_save "${repo}" "${branch}" "${config}" "${user}" "${token}"; then
            return 0
        fi
        if ((firstboot)); then
            read -r -p "  Press Enter to try again. " _ || true
        else
            echo "  Try again (${attempt}/3)."
            sleep 2
        fi
    done
}

# quiet_console: let the boot finish printing, then keep systemd status lines
# and kernel/journald messages off the console so they don't cover the prompt.
quiet_console() {
    local i
    # Wait (up to 60 s) until no other job is running -- the units that wait
    # on this one (getty, multi-user.target) sit in "waiting".
    for ((i = 0; i < 60; i++)); do
        systemctl list-jobs --no-legend --plain 2>/dev/null |
            awk '$4 == "running" && $2 != "lm-server-firstboot.service"' |
            grep -q . || break
        sleep 1
    done
    kill -s RTMIN+21 1 2>/dev/null || true # systemd: stop status output on the console
    dmesg -n 1 2>/dev/null || true         # kernel: only emergencies on the console
}

# secrets_config_path: path of the config file inside the secrets repo.
# Older setups stored only its folder (SUBDIR). Needs lms_load_secrets.
secrets_config_path() {
    local dir=${LMS_S[SUBDIR]:-}
    dir=${dir#/}
    if [[ -n ${LMS_S[CONFIG]:-} ]]; then
        echo "${LMS_S[CONFIG]}"
    elif [[ -n ${dir%/} ]]; then
        echo "${dir%/}/${LMS_CONFIG_FILE}"
    else
        echo "${LMS_CONFIG_FILE}"
    fi
}

# setup_save <repo> <branch> <config> <user> <token>: validates access, then writes.
setup_save() {
    local repo=$1 branch=$2 config=${3#/} user=$4 token=$5
    [[ ${repo} =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || {
        lms_log "repo must look like owner/name"
        return 1
    }
    [[ ${config} == *.toml && /${config}/ != */../* ]] || {
        lms_log "config must be the path of a .toml file in the repo, e.g. lm-server.toml or server/lm-server.toml"
        return 1
    }
    lms_log "checking access to github.com/${repo} (${branch})..."
    if ! LMS_GIT_USER=${user} LMS_GIT_TOKEN=${token} lms_git ls-remote --exit-code \
        "https://github.com/${repo}.git" "refs/heads/${branch}" >/dev/null; then
        lms_log "cannot read ${repo}@${branch} with these credentials"
        return 1
    fi
    local tmp
    tmp=$(mktemp "${LMS_STATE}/.secrets.XXXXXX")
    chmod 0600 "${tmp}"
    {
        lms_env_line REPO "${repo}"
        lms_env_line BRANCH "${branch}"
        lms_env_line CONFIG "${config}"
        lms_env_line GITHUB_USER "${user}"
        lms_env_line GITHUB_TOKEN "${token}"
    } >"${tmp}"
    local old=""
    if [[ -f ${LMS_SECRETS_ENV} ]]; then
        old="${LMS_SECRETS_ENV}.old"
        cp -p "${LMS_SECRETS_ENV}" "${old}"
    fi
    mv -f "${tmp}" "${LMS_SECRETS_ENV}"
    lms_log "saved -- pulling configs and starting services"
    systemctl start --no-block lm-server-prune-adhoc.service lm-server-services.service || true
    # Subshell: a fatal sync error (lms_die) must come back here, not exit.
    local rc=0
    (cmd_sync --force) || rc=$?
    # 0 = all applied, 3 = some services skipped (warned above): setup is
    # done either way. Anything else (no such config file in the repo,
    # unreadable file): undo, so the question comes back.
    if ((rc == 0 || rc == 3)); then
        rm -f "${old}"
        return 0
    fi
    if [[ -n ${old} ]]; then
        mv -f "${old}" "${LMS_SECRETS_ENV}"
    else
        rm -f "${LMS_SECRETS_ENV}"
    fi
    return 1
}

# ------------------------------------------------------------------ sync

# repo_pull: fetch the secrets repo (shallow) into LMS_REPO_DIR, print the
# path of lm-server.toml in it. Needs lms_load_secrets.
repo_pull() {
    local repo=${LMS_S[REPO]} branch=${LMS_S[BRANCH]:-main} path
    path=$(secrets_config_path)
    local url="https://github.com/${repo}.git"
    if [[ -d ${LMS_REPO_DIR}/.git && $(git -C "${LMS_REPO_DIR}" remote get-url origin 2>/dev/null) == "${url}" ]]; then
        lms_git -C "${LMS_REPO_DIR}" fetch -q --depth 1 origin "${branch}"
        git -C "${LMS_REPO_DIR}" reset -q --hard FETCH_HEAD
    else
        rm -rf "${LMS_REPO_DIR}"
        lms_git clone -q --depth 1 --branch "${branch}" "${url}" "${LMS_REPO_DIR}"
    fi
    local conf="${LMS_REPO_DIR}/${path}"
    [[ -f ${conf} ]] || lms_die "no ${path} in ${repo}@${branch}"
    echo "${conf}"
}

# run_detached <args>: runs `lm-server <args>` as a transient service of its
# own, shows its output and returns its exit status. A sync can restart
# cloudflared (the tunnel Cockpit is reached through) or Cockpit itself: the
# Cockpit session that started it goes away, and with it every process it
# spawned -- a sync killed halfway, its commit never recorded. As a service it
# runs to the end; this side only follows its journal.
run_detached() {
    local unit="lm-server-run-${$}-${RANDOM}.service" sub rc
    # Results of runs whose follower went away (e.g. with the Cockpit session).
    systemctl list-units --all --plain --no-legend 'lm-server-run-*.service' |
        awk '$4 == "exited" || $3 == "failed" { print $1 }' |
        xargs -r sh -c 'systemctl stop "$@"; systemctl reset-failed "$@"' _ 2>/dev/null || true
    # /usr/bin/lm-server itself, not through a shell: then it runs in the same
    # SELinux domain as lm-server-sync.service (unconfined). Started as
    # /bin/bash it stays init_t, which may not touch the services' volumes.
    # RemainAfterExit keeps the unit, and its exit status, until read below.
    systemd-run --quiet --unit="${unit}" --service-type=exec -p RemainAfterExit=yes \
        -p StandardOutput=journal -p StandardError=journal --setenv=LMS_DETACHED=1 \
        /usr/bin/lm-server "$@"
    # Its own output only (-u would add systemd's "Started ..." lines too).
    journalctl -f -n all -o cat "_SYSTEMD_UNIT=${unit}" &
    local follow=$!
    while :; do
        sub=$(systemctl show -p SubState --value "${unit}" 2>/dev/null || true)
        case ${sub} in
        exited | failed | dead | "") break ;;
        esac
        sleep 0.5
    done
    rc=$(systemctl show -p ExecMainStatus --value "${unit}" 2>/dev/null || true)
    [[ -n ${sub} && ${rc} =~ ^[0-9]+$ ]] || rc=1 # gone without a result
    sleep 1 # let the journal catch up
    kill "${follow}" 2>/dev/null || true
    wait "${follow}" 2>/dev/null || true
    systemctl stop "${unit}" 2>/dev/null || true
    systemctl reset-failed "${unit}" 2>/dev/null || true
    return "${rc}"
}

cmd_sync() {
    # From a terminal or Cockpit: as its own service (see run_detached).
    # lm-server-sync/-firstboot.service are one already (LMS_DETACHED=1).
    if [[ -z ${LMS_DETACHED:-} ]]; then
        run_detached config pull "$@"
        return
    fi
    local force=0
    [[ ${1:-} == --force ]] && force=1
    lms_load_secrets || {
        lms_log "not configured yet -- run: sudo lm-server config setup"
        return 0
    }
    exec 9>/run/lm-server-sync.lock
    flock -n 9 || {
        lms_log "a sync is already running"
        return 0
    }
    storage_cleanup
    storage_migrate

    local conf
    conf=$(repo_pull)

    # Render everything into a scratch dir, then swap in per service.
    local new="${LMS_ENV}/.new" rc=0
    rm -rf "${new}"
    mkdir -m 0700 "${new}"
    LMS_GITHUB_TOKEN=${LMS_S[GITHUB_TOKEN]:-} LMS_GITHUB_USER=${LMS_S[GITHUB_USER]:-} \
        "${LMS_RENDER}" render "${conf}" "${new}" || rc=$?
    ((rc < 2)) || lms_die "${LMS_CONFIG_FILE} could not be read"

    rm -rf "${LMS_ENV}/host"
    mv "${new}/host" "${LMS_ENV}/host"
    # What changed (host settings, services apply_service stopped or
    # restarted), for the summary below -- a file, since every service is
    # applied in a subshell of its own.
    SYNC_CHANGED_FILE=$(mktemp /run/lm-server-changed.XXXXXX)
    local host_changed item
    host_changed=$("${LMS_LIBEXEC}/apply-host.sh") || lms_log "warning: host settings not fully applied"
    for item in ${host_changed}; do sync_changed "host/${item}"; done

    local svc rc skipped=() failed=()
    for svc in $(lms_services); do
        if [[ -f ${new}/.errors/${svc} ]]; then
            if lms_enabled "${svc}"; then
                lms_log "${svc}: $(cat "${new}/.errors/${svc}") -- keeping the previous config"
            else
                lms_log "${svc}: $(cat "${new}/.errors/${svc}") -- not started"
            fi
            skipped+=("${svc}")
            continue
        fi
        # One service failing (a copy that breaks off, a disk that won't
        # mount) must not stop the others: each in a subshell, which set -e
        # ends at its first error. (Not in an `if`: that would switch set -e
        # off inside.)
        set +e
        (
            set -e
            apply_service "${svc}" "${new}/${svc}" "${force}"
        )
        rc=$?
        set -e
        case ${rc} in
        0) ;;
        10) skipped+=("${svc}") ;; # its disk/storage can't be set up (logged)
        *)
            lms_log "${svc}: error while applying (exit ${rc}, see above) -- the other services go on"
            failed+=("${svc}")
            ;;
        esac
    done
    rm -rf "${new}"
    local -a changed=()
    mapfile -t changed <"${SYNC_CHANGED_FILE}"
    rm -f "${SYNC_CHANGED_FILE}"

    git -C "${LMS_REPO_DIR}" rev-parse HEAD >"${LMS_STATE}/config.rev"
    date -Is >"${LMS_STATE}/config.synced"
    local rev
    rev=$(git -C "${LMS_REPO_DIR}" rev-parse --short HEAD)
    if ((${#changed[@]})); then
        lms_log "synced ${rev} ($(secrets_config_path)) -- changed: ${changed[*]}"
    else
        lms_log "synced ${rev} ($(secrets_config_path)) -- no changes, nothing restarted"
    fi
    # 3 = synced, but these services are unavailable until fixed.
    ((${#failed[@]} == 0)) || lms_log "warning: failed ${failed[*]} -- see above; the next sync tries again"
    if ((${#skipped[@]})); then
        lms_log "warning: skipped ${skipped[*]} -- fix lm-server.toml (or the disk), then: lm-server config pull"
    fi
    ((${#skipped[@]} + ${#failed[@]} == 0)) || return 3
    return 0
}

sync_changed() { echo "$1" >>"${SYNC_CHANGED_FILE}"; }

# apply_service <svc> <rendered-dir> <force>: swaps in the new config and
# (re)starts the service only if its rendered files changed.
apply_service() {
    local svc=$1 src=$2 force=$3 dst="${LMS_ENV}/$1"
    local -a units
    mapfile -t units < <(lms_units "${svc}")

    if [[ ! -d ${src} ]]; then
        if lms_enabled "${svc}"; then
            lms_log "${svc}: removed from ${LMS_CONFIG_FILE} -- stopping"
            systemctl stop "${units[@]}" || true
            rm -f "${dst}/enabled"
            sync_changed "${svc}"
        fi
        apply_quadlets "${svc}" "${src}"
        return 0
    fi
    if ((!force)) && lms_enabled "${svc}" && [[ $(lms_dir_hash "${src}") == "$(lms_dir_hash "${dst}")" ]]; then
        return 0
    fi

    # Exit 10 = its disk/storage can't be set up (logged): nothing applied,
    # it keeps running as it was (or stays off); the next sync tries again.
    apply_storage "${svc}" "${src}"
    apply_limits "${svc}" "${src}"
    apply_quadlets "${svc}" "${src}"
    rm -rf "${dst}"
    mv "${src}" "${dst}"
    touch "${dst}/enabled"
    lms_log "${svc}: config applied -- (re)starting"
    sync_changed "${svc}"
    systemctl reset-failed "${units[@]}" 2>/dev/null || true
    systemctl restart --no-block "${units[@]}"
    if [[ -x ${LMS_LIBEXEC}/provision/${svc}.sh ]]; then
        rm -f "${LMS_STATE}/provisioned/${svc}" # until it has worked for this config
        systemctl restart --no-block "lm-server-provision@${svc}.service"
    fi
}

# apply_storage <svc> <rendered-dir>: all data of a service lives in
# volumes/<svc>. What's mounted there (from its section of lm-server.toml):
#   disk = "/var/mnt/<path>"   a bind mount of exactly that folder
#   storage = "80G"            a filesystem of that size: an ext4 image file,
#                              <svc>.img in the disk folder (or in
#                              /var/lib/lm-server/disks/), loop-mounted --
#                              when it's full, only this service notices
#   neither                    nothing: a plain folder on the system disk
# (Rendered as the files "storage" = the folder and "disk" = the size -- the
# older key names.) On a change the service is stopped and its data copied
# over (only into an empty target -- the old copy is kept, never deleted). A
# bigger size grows the image in place; a smaller one is refused. Called
# from apply_service (its ${units[@]} are in scope).
apply_storage() {
    local svc=$1 src=$2 vol="${LMS_VOLUMES}/$1"
    local folder="" size="" want cur="" unit file
    [[ -f ${src}/storage ]] && folder=$(<"${src}/storage")
    [[ -f ${src}/disk ]] && size=$(<"${src}/disk")
    want=${folder}
    [[ -n ${size} ]] && want="${folder:-${LMS_STATE}/disks}/${svc}.img"
    unit=$(systemd-escape -p --suffix=mount "${vol}")
    file="/etc/systemd/system/${unit}"
    # Now: a bind mount (unit file), or an image (its /etc/fstab entry).
    [[ -f ${file} ]] && cur=$(sed -n 's/^What=//p' "${file}")
    [[ -n ${cur} ]] || cur=$(fstab_image "${svc}")
    mkdir -p "${vol}"

    if [[ ${want} != "${cur}" ]]; then
        if [[ -n ${size} ]]; then
            # The data has to fit (with 10% to spare), or nothing changes.
            local need
            need=$(du -sxb "${vol}" 2>/dev/null | cut -f1)
            if ((${need:-0} > $(numfmt --from=iec "${size}") * 9 / 10)); then
                lms_log "${svc}: error: its data ($(numfmt --to=iec "${need}")) doesn't fit in storage = \"${size}\" -- not applied"
                return 10
            fi
            # ...and a new image needs that much free space where it goes
            # (the disk folder -- or the system disk, if nothing is mounted there).
            if [[ ! -e ${want} ]] && ! disk_space_for "${svc}" "${want}" "$(numfmt --from=iec "${size}")"; then
                return 10
            fi
        fi
        lms_log "${svc}: data location ${cur:-system disk} -> ${want:-system disk}${size:+ (${size} of its own)}"
        systemctl stop "${units[@]}" 2>/dev/null || true
        if [[ -f ${file} ]]; then
            systemctl disable --now "${unit}" || true
            rm -f "${file}"
        fi
        if [[ -n $(fstab_image "${svc}") ]]; then
            systemctl stop "${unit}" || true
            image_detach "${cur}"
            fstab_image_set "${svc}" ""
        fi
        [[ -z ${folder} ]] || storage_check "${svc}" "${folder}"

        # from: where the data is now; to: where it goes. Images are mounted
        # under /run for the copy.
        local from to stage_from="" stage_to=""
        if [[ ${cur} == *.img ]]; then
            stage_from=$(mktemp -d /run/lm-server-from.XXXXXX)
            mount -o loop,ro "${cur}" "${stage_from}"
            from=${stage_from}
        else
            from=${cur:-${vol}}
        fi
        if [[ -n ${size} ]]; then
            disk_image_new "${svc}" "${want}" "${size}"
            stage_to=$(mktemp -d /run/lm-server-to.XXXXXX)
            mount -o loop "${want}" "${stage_to}"
            to=${stage_to}
        else
            [[ -z ${folder} ]] || mkdir -p "${folder}"
            to=${want:-${vol}}
        fi
        if [[ -n $(ls -A "${from}" 2>/dev/null) && -z $(ls -A "${to}" 2>/dev/null) ]]; then
            lms_log "${svc}: copying $(du -sh "${from}" | cut -f1) from ${cur:-${vol}} to ${want:-${vol}}..."
            # Not the image itself: it may sit in the very folder the data
            # comes from (disk = that folder, storage newly set).
            rsync -aHA --exclude="/${svc}.img" "${from}/" "${to}/"
            lms_log "${svc}: copied -- the old copy is left in ${cur:-${vol}}; delete it once everything works"
        fi
        [[ -z ${stage_from} ]] || { umount "${stage_from}" && rmdir "${stage_from}"; }
        [[ -z ${stage_to} ]] || { umount "${stage_to}" && rmdir "${stage_to}"; }

        if [[ -n ${size} ]]; then
            fstab_image_set "${svc}" "${want}"
        elif [[ -n ${want} ]]; then
            cat >"${file}" <<EOF
# Written by lm-server: [${svc}] disk in lm-server.toml.
[Unit]
Description=lm-server: ${svc} data on ${want%/*}

[Mount]
What=${want}
Where=${vol}
Type=none
Options=bind

[Install]
WantedBy=local-fs.target
EOF
        fi
        systemctl daemon-reload
        if [[ -n ${size} ]]; then
            systemctl start "${unit}" # generated from /etc/fstab
        elif [[ -n ${want} ]]; then
            systemctl enable --now "${unit}"
        fi
    elif [[ -n ${size} ]]; then
        disk_image_grow "${svc}" "${want}" "${size}"
    fi

    local d
    if [[ -f ${src}/volumes ]]; then
        while IFS= read -r d; do
            [[ -n ${d} ]] && mkdir -p "${vol}/${d}"
        done <"${src}/volumes"
    fi
}

# A service's image is mounted from /etc/fstab, by the UUID of its
# filesystem: Cockpit > Storage only knows fstab, and a mount it can't find
# there it reports as "won't be mounted after the next boot". The loop
# device the UUID shows up on is attached first by lm-server-image@<image>
# (x-systemd.requires). nofail: an image that's missing doesn't stop the
# boot -- only its service stays down (RequiresMountsFor).

# fstab_image <svc>: the image in the service's /etc/fstab entry, if any.
fstab_image() {
    sed -n "s|^# lm-server $1: \([^ ]*\.img\) .*|\1|p" /etc/fstab 2>/dev/null | head -n1
}

# fstab_image_set <svc> <image>: writes its entry (a marker comment and the
# mount line); with "" as the image it's removed.
fstab_image_set() {
    local svc=$1 img=$2 tmp uuid req
    tmp=$(mktemp /etc/.fstab.XXXXXX)
    awk -v tag="# lm-server ${svc}: " 'index($0, tag) == 1 { skip = 1; next } skip { skip = 0; next } { print }' \
        /etc/fstab >"${tmp}"
    if [[ -n ${img} ]]; then
        uuid=$(blkid -s UUID -o value "${img}")
        req=$(systemd-escape -p --template=lm-server-image@.service "${img}")
        printf '# lm-server %s: %s (storage in lm-server.toml; written by lm-server)\n' "${svc}" "${img}" >>"${tmp}"
        printf 'UUID=%s %s ext4 noatime,nofail,x-systemd.device-timeout=30s,x-systemd.requires=%s 0 0\n' \
            "${uuid}" "${LMS_VOLUMES}/${svc}" "${req}" >>"${tmp}"
    fi
    # In place: keeps the file's owner, mode and SELinux label.
    cat "${tmp}" >/etc/fstab
    rm -f "${tmp}"
}

# image_attach <image>: a loop device for it (once), for its UUID to appear.
image_attach() {
    losetup -j "$1" -n -O NAME | grep -q . || losetup --find "$1"
    udevadm settle --timeout=10 2>/dev/null || true
}

# image_detach <image>: frees its loop devices (the stopped mount's).
image_detach() {
    local dev
    for dev in $(losetup -j "$1" -n -O NAME); do
        losetup -d "${dev}" 2>/dev/null || true
    done
}

# storage_migrate: images mounted by a unit of their own (lm-server before
# fstab entries) are moved to /etc/fstab -- their service stopped for it.
storage_migrate() {
    local f what where svc unit
    for f in /etc/systemd/system/*.mount; do
        [[ -f ${f} ]] || continue
        what=$(sed -n 's/^What=//p' "${f}")
        where=$(sed -n 's/^Where=//p' "${f}")
        [[ ${what} == *.img && ${where} == "${LMS_VOLUMES}"/* ]] || continue
        svc=${where##*/}
        unit=${f##*/}
        local -a units=()
        mapfile -t units < <(lms_units "${svc}")
        lms_log "${svc}: its storage moves to /etc/fstab (for Cockpit > Storage) -- restarting"
        systemctl stop "${units[@]}" 2>/dev/null || true
        systemctl disable --now "${unit}" || true
        rm -f "${f}"
        image_detach "${what}"
        fstab_image_set "${svc}" "${what}"
        systemctl daemon-reload
        systemctl start "${unit}"
        ! lms_enabled "${svc}" || systemctl start --no-block "${units[@]}"
    done
}

# storage_cleanup: a sync that died while moving data (see apply_storage)
# can leave an image mounted under /run -- mounting it again next to that
# would be two filesystems on one image. Unmounted before anything else.
storage_cleanup() {
    local m
    for m in $(findmnt -rn -o TARGET | grep -E '^/run/lm-server-(from|to|new)\.' || true); do
        umount "${m}" && rmdir "${m}" && lms_log "unmounted ${m}, left over from an interrupted data move"
    done
}

# storage_check <svc> <folder>: warns if the folder is on the system disk,
# i.e. the disk meant to be mounted there isn't (same filesystem as
# /var/lib/lm-server, judged by the nearest existing folder).
storage_check() {
    local probe=$2
    while [[ ! -e ${probe} ]]; do probe=${probe%/*}; done
    [[ $(stat -c %d "${probe:-/}") != "$(stat -c %d "${LMS_STATE}")" ]] ||
        lms_log "$1: warning: $2 is on the system disk (no disk mounted there, see Cockpit > Storage)"
}

# disk_space_for <svc> <path> <bytes>: is there that much free space where
# <path> goes (its nearest existing folder)? Logs why not.
disk_space_for() {
    local probe=${2%/*} free
    while [[ ! -e ${probe} ]]; do probe=${probe%/*}; done
    free=$(df -B1 --output=avail "${probe:-/}" | tail -n1)
    free=${free// /}
    if ((free < $3)); then
        lms_log "$1: error: $(numfmt --to=iec "$3") needed for its storage, but only $(numfmt --to=iec "${free}") free in ${probe:-/} -- not applied"
        return 1
    fi
}

# disk_image_new <svc> <image> <size>: an empty ext4 filesystem in a file of
# that size (space reserved up front), unless it exists already.
disk_image_new() {
    local img=$2
    [[ -e ${img} ]] && return 0
    mkdir -p "${img%/*}"
    # btrfs: no copy-on-write for a file that's rewritten in place all the time.
    chattr +C "${img%/*}" 2>/dev/null || true
    # Reserved for real (the space was checked: disk_space_for); a sparse
    # file only where fallocate isn't supported at all.
    local err
    if ! err=$(fallocate -l "$3" "${img}" 2>&1); then
        rm -f "${img}"
        [[ ${err} == *"not supported"* ]] || lms_die "$1: cannot reserve $3 for ${img}: ${err}"
        truncate -s "$3" "${img}"
    fi
    mkfs.ext4 -q -F -m 0 -L "${1:0:16}" "${img}"
    # An empty filesystem, for the "copy only into an empty target" check.
    local tmp
    tmp=$(mktemp -d /run/lm-server-new.XXXXXX)
    mount -o loop "${img}" "${tmp}"
    rmdir "${tmp}/lost+found" 2>/dev/null || true
    umount "${tmp}"
    rmdir "${tmp}"
    lms_log "$1: created its $3 filesystem (${img})"
}

# disk_image_grow <svc> <image> <size>: a bigger `storage` grows the image and its
# filesystem, online if it's mounted. Smaller: refused (ext4 can't shrink live).
disk_image_grow() {
    local img=$2 want have dev
    want=$(numfmt --from=iec "$3")
    have=$(stat -c %s "${img}")
    if ((want < have)); then
        lms_log "$1: storage stays at $(numfmt --to=iec "${have}") -- it can't be made smaller (storage = \"$3\")"
        return 0
    fi
    ((want > have)) || return 0
    disk_space_for "$1" "${img}" $((want - have)) || return 0
    fallocate -l "$3" "${img}" 2>/dev/null || truncate -s "$3" "${img}"
    dev=$(losetup -j "${img}" -n -O NAME | head -n1)
    if [[ -n ${dev} ]]; then
        losetup -c "${dev}"
        resize2fs "${dev}" >/dev/null 2>&1
    else
        e2fsck -fp "${img}" >/dev/null
        resize2fs "${img}" >/dev/null 2>&1
    fi
    lms_log "$1: storage grown to $3"
}

# apply_limits <svc> <rendered-dir>: CPU/RAM limits of lm-server-<svc>.slice,
# applied live and kept across reboots (systemctl set-property).
apply_limits() {
    local -a props=()
    [[ -f $2/limits ]] && mapfile -t props <"$2/limits"
    ((${#props[@]})) || return 0
    systemctl set-property "lm-server-$1.slice" "${props[@]}" ||
        lms_log "$1: could not apply limits (${props[*]})"
}

# apply_quadlets <svc> <rendered-dir>: the service's rendered quadlet/<unit>.conf
# as drop-ins, /etc/containers/systemd/<unit>.d/lm-server-<svc>.conf (e.g.
# [immich] gpu); ones it no longer renders are removed. Quadlet reads them
# at daemon-reload, before apply_service restarts the service.
apply_quadlets() {
    local svc=$1 src=$2 f unit dropin reload=0
    local -A want=()
    if [[ -d ${src}/quadlet ]]; then
        for f in "${src}"/quadlet/*.conf; do
            [[ -f ${f} ]] || continue
            unit=$(basename "${f}" .conf)
            dropin="/etc/containers/systemd/${unit}.d/lm-server-${svc}.conf"
            want[${dropin}]=1
            cmp -s "${f}" "${dropin}" && continue
            install -D -m 0644 "${f}" "${dropin}"
            reload=1
        done
    fi
    for dropin in /etc/containers/systemd/*.d/lm-server-"${svc}".conf; do
        [[ -f ${dropin} && -z ${want[${dropin}]:-} ]] || continue
        rm -f "${dropin}"
        rmdir --ignore-fail-on-non-empty "${dropin%/*}"
        reload=1
    done
    ((!reload)) || systemctl daemon-reload
}

cmd_start_enabled() {
    local svc
    for svc in $(lms_services); do
        lms_enabled "${svc}" || continue
        mapfile -t units < <(lms_units "${svc}")
        systemctl start --no-block "${units[@]}"
        # Provisioning that didn't get through (the app wasn't up yet, ...)
        # is tried again at every boot, until it has.
        if [[ -x ${LMS_LIBEXEC}/provision/${svc}.sh && ! -e ${LMS_STATE}/provisioned/${svc} ]]; then
            systemctl start --no-block "lm-server-provision@${svc}.service"
        fi
    done
}

# ------------------------------------------------------------------ config editing

# config setup: (re)enter the secrets repo + credentials (cmd_setup).
# config pull [--force]: fetch + apply (cmd_sync).
# config show: the current lm-server.toml (freshly pulled).
# config rev:  the commit it comes from (for `save --base`).
# config source: repo, branch, config file path and GitHub user in use.
# config status: the commit applied last (+ when) and the newest one on GitHub.
# config save [--base <commit>] [--message <text>]: new lm-server.toml on
#   stdin -> checked, committed and pushed to the secrets repo, then applied.
#   Refused if the repo moved past <commit> meanwhile (someone else edited it).
#   Pushing needs a token with "Contents: Read and write".
cmd_config() {
    local sub=${1:-}
    shift || true
    # config pull: fetch what was pushed to GitHub, apply it.
    case ${sub} in
    setup)
        cmd_setup "$@"
        return
        ;;
    pull)
        cmd_sync "$@"
        return
        ;;
    esac
    lms_load_secrets || lms_die "not configured yet -- run: sudo lm-server config setup"
    # config source: where the config comes from (Cockpit fills the setup
    # form with it). The token is never printed.
    if [[ ${sub} == source ]]; then
        lms_env_line REPO "${LMS_S[REPO]}"
        lms_env_line BRANCH "${LMS_S[BRANCH]:-main}"
        lms_env_line CONFIG "$(secrets_config_path)"
        lms_env_line GITHUB_USER "${LMS_S[GITHUB_USER]:-}"
        return
    fi
    if [[ ${sub} == status ]]; then
        local remote
        remote=$(lms_git ls-remote --exit-code "https://github.com/${LMS_S[REPO]}.git"             "refs/heads/${LMS_S[BRANCH]:-main}" | cut -f1) || lms_die "cannot read ${LMS_S[REPO]} from GitHub"
        lms_env_line REPO "${LMS_S[REPO]}"
        lms_env_line BRANCH "${LMS_S[BRANCH]:-main}"
        lms_env_line SYNCED_REV "$(cat "${LMS_STATE}/config.rev" 2>/dev/null || true)"
        lms_env_line SYNCED_AT "$(cat "${LMS_STATE}/config.synced" 2>/dev/null || true)"
        lms_env_line REMOTE_REV "${remote}"
        return
    fi
    exec 9>/run/lm-server-sync.lock
    flock 9
    local conf
    conf=$(repo_pull)
    case ${sub} in
    show) cat "${conf}" ;;
    rev) git -C "${LMS_REPO_DIR}" rev-parse HEAD ;;
    save) config_save "${conf}" "$@" ;;
    *) lms_die "usage: lm-server config setup|pull|show|rev|source|status|save [--base <commit>] [--message <text>]" ;;
    esac
}

config_save() {
    local conf=$1 base="" msg=""
    shift
    while (($#)); do
        case $1 in
        --base) base=$2 && shift ;;
        --message) msg=$2 && shift ;;
        *) lms_die "config save: unknown argument $1" ;;
        esac
        shift
    done
    local head
    head=$(git -C "${LMS_REPO_DIR}" rev-parse HEAD)
    if [[ -n ${base} && ${base} != "${head}" ]]; then
        lms_die "the repo changed since you opened it (now ${head:0:7}) -- reload and redo your edit"
    fi

    local tmp rc=0
    tmp=$(mktemp /run/lm-server-toml.XXXXXX)
    trap 'rm -f "${tmp}"' RETURN
    cat >"${tmp}"
    "${LMS_RENDER}" check "${tmp}" || rc=$?
    ((rc < 2)) || lms_die "not saved: ${LMS_CONFIG_FILE} is not valid TOML (see above)"
    ((rc == 0)) || lms_log "warning: the services listed above won't start until fixed"

    cp "${tmp}" "${conf}"
    if git -C "${LMS_REPO_DIR}" diff --quiet; then
        lms_log "no changes"
    else
        git -C "${LMS_REPO_DIR}" -c user.name="lm-server" -c user.email="lm-server@$(hostnamectl hostname)" \
            commit -q -am "${msg:-Update ${LMS_CONFIG_FILE} from $(hostnamectl hostname)}"
        if ! lms_git -C "${LMS_REPO_DIR}" push -q origin "HEAD:${LMS_S[BRANCH]:-main}"; then
            git -C "${LMS_REPO_DIR}" reset -q --hard "${head}"
            lms_die "push failed -- the GitHub token needs \"Contents: Read and write\" on ${LMS_S[REPO]}"
        fi
        lms_log "pushed $(git -C "${LMS_REPO_DIR}" rev-parse --short HEAD) to ${LMS_S[REPO]}"
    fi
    exec 9>&-
    cmd_sync
}

# ------------------------------------------------------------------ services

svc_arg() {
    [[ -n ${1:-} ]] || lms_die "missing service name (see: lm-server services)"
    lms_service_exists "$1" || lms_die "unknown service: $1"
}

cmd_services() {
    local name units routes desc u state line mem limit
    printf '%-12s %-7s %-10s %-17s %s\n' SERVICE CONFIG STATE MEMORY/LIMIT DESCRIPTION
    while IFS=$'\t' read -r name units routes desc; do
        line=""
        for u in ${units}; do
            state=$(systemctl is-active "${u}.service" 2>/dev/null || true)
            line+="${state} "
        done
        if lms_enabled "${name}"; then state=yes; else state=-; fi
        # Usage of the whole service (all its containers) from its slice.
        mem=$(systemctl show -P MemoryCurrent "lm-server-${name}.slice" 2>/dev/null || true)
        limit=$(systemctl show -P MemoryMax "lm-server-${name}.slice" 2>/dev/null || true)
        [[ ${mem} =~ ^[0-9]+$ ]] && mem=$(numfmt --to=iec "${mem}") || mem=-
        [[ ${limit} =~ ^[0-9]+$ ]] && limit=$(numfmt --to=iec "${limit}") || limit=-
        printf '%-12s %-7s %-10s %-17s %s\n' "${name}" "${state}" "${line% }" "${mem}/${limit}" "${desc}"
    done < <(lms_catalog)
}

cmd_unit_action() {
    local action=$1 svc=${2:-}
    svc_arg "${svc}"
    mapfile -t units < <(lms_units "${svc}")
    if [[ ${action} != stop ]] && ! lms_enabled "${svc}"; then
        lms_die "${svc} has no config (add [${svc}] to ${LMS_CONFIG_FILE})"
    fi
    systemctl "${action}" "${units[@]}"
}

# Logs of every container of a service (a pod's containers are separate units).
cmd_logs() {
    local svc=${1:-} u
    svc_arg "${svc}"
    shift
    local args=()
    for u in $(lms_units "${svc}"); do args+=(-u "${u}"); done
    for u in $(podman ps -a --filter "pod=${svc}" --format '{{.Names}}' 2>/dev/null); do
        args+=(-u "${u}.service")
    done
    journalctl -n 200 "${args[@]}" "$@"
}

# services [list] | start|stop|restart|logs <service> | resources | routes
cmd_services_group() {
    local sub=${1:-list}
    shift || true
    case ${sub} in
    list) cmd_services ;;
    start | stop | restart) cmd_unit_action "${sub}" "$@" ;;
    logs) cmd_logs "$@" ;;
    resources) "${LMS_LIBEXEC}/resources.py" "$@" ;;
    routes) cmd_routes ;;
    *) lms_die "usage: lm-server services [list] | start|stop|restart|logs <service> | resources [--json] | routes" ;;
    esac
}

cmd_routes() {
    local name units routes desc r
    printf '%-28s %s\n' HOSTNAME SERVICE
    while IFS=$'\t' read -r name units routes desc; do
        for r in ${routes}; do
            printf '%-28s %s\n' "${r%%=*}" "${r#*=}"
        done
    done < <(lms_catalog)
    echo
    echo "https://localhost:9090 (Cockpit) needs TLS verification disabled on the route."
    echo "<host>/<path>: hostname <host>, Path ^/<path>(/|\$), listed above <host>'s route without a path."
}

# ------------------------------------------------------------------ status/updates

cmd_status() {
    echo "== System image"
    bootc status --format=humanreadable 2>/dev/null || bootc status || true
    echo
    echo "== Configs"
    if lms_load_secrets; then
        echo "repo:   ${LMS_S[REPO]}@${LMS_S[BRANCH]:-main} ($(secrets_config_path))"
        echo "commit: $(cat "${LMS_STATE}/config.rev" 2>/dev/null || echo -)"
        echo "synced: $(cat "${LMS_STATE}/config.synced" 2>/dev/null || echo never)"
    else
        echo "not configured -- run: sudo lm-server config setup"
    fi
    echo
    echo "== Services"
    cmd_services
    echo
    echo "== Schedules"
    systemctl list-timers --all --no-pager podman-auto-update.timer lm-server-upgrade.timer lm-server-sync.timer 2>/dev/null |
        sed '/^$/,$d'
}

# What the automatic jobs did lately (container updates, system upgrades, syncs).
cmd_history() {
    journalctl --no-pager -o short-iso -n "${1:-100}" \
        -u podman-auto-update.service -u lm-server-upgrade.service -u lm-server-sync.service \
        -u 'lm-server-run-*.service'
}

# system update [--check | --apply] [--progress]: the next system image,
# staged for the next reboot (--apply: reboot into it now). --progress:
# bootc's progress events (JSON Lines, one object per line) on stdout, next to
# its normal output -- the Cockpit page draws a bar from them.
system_update() {
    local progress=() mode=""
    while (($#)); do
        case $1 in
        --progress) progress=(--progress-fd 3) ;;
        --check | --apply) mode=$1 ;;
        *) lms_die "system update: unknown argument $1" ;;
        esac
        shift
    done
    case ${mode} in
    --check) bootc upgrade --check ;;
    --apply) bootc upgrade "${progress[@]}" --apply 3>&1 ;;
    *) bootc upgrade "${progress[@]}" 3>&1 && echo "Staged -- reboot (or run: lm-server system update --apply) to switch to it." ;;
    esac
}

cmd_system() {
    local sub=${1:-}
    shift || true
    case ${sub} in
    update) system_update "$@" ;;
    rollback) bootc rollback ;;
    *) lms_die "usage: lm-server system update [--check|--apply] [--progress] | rollback" ;;
    esac
}

# containers update [--check]: podman auto-update (newer images under the
# same tags; a service that fails to restart is rolled back), then the
# containers that follow a file upstream (image_sources.py), then the images
# that left unused (cleanup.py). podman-auto-update.service does the same.
containers_update() {
    case ${1:-} in
    --check)
        podman auto-update --dry-run
        "${LMS_LIBEXEC}/image_sources.py"
        ;;
    "")
        # Restarts services: must not die halfway with a Cockpit session
        # (see run_detached).
        if [[ -z ${LMS_DETACHED:-} ]]; then
            run_detached containers update
            return
        fi
        local rc=0
        podman auto-update || rc=$?
        "${LMS_LIBEXEC}/image_sources.py" --apply || rc=$?
        "${LMS_LIBEXEC}/cleanup.py" || true
        return "${rc}"
        ;;
    *) lms_die "containers update: unknown argument $1" ;;
    esac
}

cmd_containers() {
    local sub=list
    if [[ -n ${1:-} && ${1} != -* ]]; then
        sub=$1
        shift
    fi
    case ${sub} in
    list) "${LMS_LIBEXEC}/containers.py" "$@" ;;
    update) containers_update "$@" ;;
    cleanup) "${LMS_LIBEXEC}/cleanup.py" ;;
    remove-adhoc) "${LMS_LIBEXEC}/prune-adhoc.sh" --force ;;
    *) lms_die "usage: lm-server containers [list] [--json] | update [--check] | cleanup | remove-adhoc" ;;
    esac
}

# update [--config] [-c|--containers] [-s|--system] [--check] [--apply]: the
# config, the containers and the system image, in this order (what Cockpit's
# "Update all" does) -- all three, or the ones named. Each step runs as its
# own lm-server, so one failing doesn't stop the others.
cmd_update() {
    local cfg=0 ctr=0 sys=0 check=0 apply=0 rc=0 arg i
    while (($#)); do
        arg=$1
        case ${arg} in
        --config) cfg=1 ;;
        --containers) ctr=1 ;;
        --system) sys=1 ;;
        --check) check=1 ;;
        --apply) apply=1 ;;
        -[cs]*)
            for ((i = 1; i < ${#arg}; i++)); do
                case ${arg:i:1} in
                c) ctr=1 ;;
                s) sys=1 ;;
                *) lms_die "update: unknown option -${arg:i:1}" ;;
                esac
            done
            ;;
        *) lms_die "update: unknown argument ${arg} (see: lm-server help)" ;;
        esac
        shift
    done
    ((cfg || ctr || sys)) || cfg=1 ctr=1 sys=1
    if ((cfg)); then
        echo "== Config"
        if ((check)); then "$0" config status || rc=1; else "$0" config pull || rc=1; fi
    fi
    if ((ctr)); then
        echo "== Containers"
        if ((check)); then "$0" containers update --check || rc=1; else "$0" containers update || rc=1; fi
    fi
    if ((sys)); then
        echo "== System image"
        if ((check)); then
            "$0" system update --check || rc=1
        elif ((apply)); then
            "$0" system update --apply || rc=1
        else
            "$0" system update || rc=1
        fi
    fi
    return "${rc}"
}

# ------------------------------------------------------------------ main

ARGV=("$@")
# The whole command line again, as root.
root() {
    [[ ${EUID} -eq 0 ]] || exec sudo -- "$0" "${ARGV[@]}"
}

cmd=${1:-}
[[ -n ${cmd} ]] || {
    usage
    exit 1
}
shift
case ${cmd} in
-h | --help | help) usage ;;
status) root && cmd_status ;;
history) root && cmd_history "$@" ;;
update) root && cmd_update "$@" ;;
system) root && cmd_system "$@" ;;
containers) root && cmd_containers "$@" ;;
config) root && cmd_config "$@" ;;
services)
    case ${1:-list} in
    list | routes) ;;
    *) root ;;
    esac
    cmd_services_group "$@"
    ;;
# lm-server-services.service (boot)
start-enabled) root && cmd_start_enabled ;;
# lm-server-image@.service (boot, before the fstab mount of a storage image)
image-attach) image_attach "$1" ;;
image-detach) image_detach "$1" ;;
*)
    usage
    exit 1
    ;;
esac
