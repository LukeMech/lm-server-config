# Parameters shared by the Justfile and CI.

# The system image (Containerfile) -- <REGISTRY>/<IMAGE_NAME>:<DEFAULT_TAG>.
# Service images (images/<name>/) are <REGISTRY>/lm-server-<name>.
IMAGE_NAME=lm-server
REGISTRY="ghcr.io/lukemech"
REPO_ORGANIZATION="LukeMech"
# GitHub repo of this project (image labels, links).
REPO_NAME="lm-server-config"
IMAGE_DESC="Home server (ex-Proxmox) as one AlmaLinux bootc image: podman quadlet services, Cockpit, config from a private repo"
IMAGE_KEYWORDS="bootc,oci,almalinux,podman,quadlet,cockpit,homelab"
IMAGE_LOGO_URL=""
DEFAULT_TAG="latest"
# The installer ISO (image-builder).
IMAGE_BUILDER_IMAGE="ghcr.io/osbuild/image-builder-cli:latest"
